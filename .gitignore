# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Claude AI assistant
# Ignore .claude/ contents by default — but track settings.json so any
# Claude session on this repo inherits the project hook/permission config
# (slice-closeout reminder, etc.). settings.local.json stays ignored — it
# holds per-user permission grants.
.claude/*
!.claude/settings.json

# Temporary files
*.tmp
*.temp
*~
.swp

# Logs
*.log
npm-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Node modules
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
/test-results/
/playwright-report/

# SSL certs (generate locally, don't commit)
server.crt
server.key

# Python bytecode (build-nikud-map.py)
__pycache__/

# Local Netlify folder
.netlify
